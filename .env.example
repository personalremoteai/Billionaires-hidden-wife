# Copy to .env locally, then add your key. Never commit .env.
GEMINI_API_KEY=
# We will set GEMINI_IMAGE_MODEL after choosing an available model in your account.
GEMINI_IMAGE_MODEL=

# Optional paid talking-face lip-sync via fal.ai; leave empty to use pan/zoom only.
FAL_KEY=
# Optional JSON object: {"Isabella Hart":"en-US-JennyNeural","Alexander Sterling":"en-US-GuyNeural"}
VOICE_MAP_JSON=
